{
  // Tests and the root config files (eslint.config.ts, vitest.config.ts) are
  // type-checked but never emitted: Vitest runs the tests from source, so
  // nothing about them belongs in `dist/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "*.ts"],
  "exclude": []
}
