{
  "name": "release-with-ease",
  "version": "2.8.0",
  "description": "A script to bump the version of an npm library and update release notes. Uses Claude to analyze commits.",
  "main": "dist/cli.js",
  "bin": {
    "release-with-ease": "bin/release-with-ease.js"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tsc": "tsc --build tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "node --env-file-if-exists=.env bin/release-with-ease.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happo/release-with-ease.git"
  },
  "keywords": [
    "release",
    "claude",
    "anthropic",
    "semver",
    "bump",
    "ai"
  ],
  "author": "henric.persson@happo.io,joe.lencioni@happo.io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/happo/release-with-ease/issues"
  },
  "homepage": "https://github.com/happo/release-with-ease#readme",
  "type": "module",
  "types": "dist/cli.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
